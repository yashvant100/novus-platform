APP_NAME=Novus URL Monitor V2
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8090
DATABASE_URL=postgresql+psycopg://novus:novus@127.0.0.1:5432/novus_monitor
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# 64 hex chars = 32 random bytes
SECRET_ENCRYPTION_KEY=
CORS_ORIGINS=http://127.0.0.1:8090,http://localhost:8090
MONITOR_DEFAULT_TIMEOUT=10
MONITOR_MAX_HISTORY=100
MONITOR_WORKER_INTERVAL=30
